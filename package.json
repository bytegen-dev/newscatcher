{
  "name": "newscatcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MIP-003 news search agent (NewsCatcher API)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "coworker:dev": "tsx watch src/coworker-worker/index.ts",
    "coworker:start": "node dist/coworker-worker/index.js",
    "test": "node --import tsx --test src/coworker-worker/parse-brief.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "canonicalize": "^2.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
