# Server
PORT=3040
DATABASE_URL="file:./dev.db"

# NewsCatcher News API (https://www.newscatcherapi.com/docs/news-api/get-started/quickstart)
NEWSCATCHER_API_KEY=
NEWSCATCHER_API_BASE_URL=https://v3-api.newscatcherapi.com/api

# Paid start_job (required after Fixed ADA registry registration)
# PAYMENT_SERVICE_URL=http://localhost:3001/api/v1
# PAYMENT_API_KEY=            # Read+Pay key from the payment node
# AGENT_IDENTIFIER=           # Full agentIdentifier from registration
# SELLER_VKEY=                # Selling wallet vkey (optional, for /get-credential)
# NETWORK=Preprod

# Optional: SaaS agent verification (GET /get-credential)
# MASUMI_VERIFICATION_SECRET=
